# ==============================================================================
# Relay Telegram Bot Configuration
# ==============================================================================

# Required: Telegram Bot Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Optional: Concurrency limit for simultaneous media downloads (Default: 3)
# Keeps CPU and RAM under control on small VPS servers
MAX_CONCURRENT_DOWNLOADS=3

# Optional: Path to cookies file for bypassing Instagram / X restrictions (Default: cookies.txt)
COOKIES_FILE=cookies.txt

# Optional: Telegram User IDs of administrators (comma-separated, e.g., 12345678,98765432)
# Admins can toggle admin-only mode (/adminonly) and use Relay when it is restricted to admins
# To find your User ID, send /ping to the bot
ADMIN_IDS=

# Optional: Path to persisted settings file for admin modes (Default: settings.json)
SETTINGS_FILE=settings.json

# ==============================================================================
# Local Telegram Bot API Server Configuration (supports videos up to 2000 MB)
# Get your TELEGRAM_API_ID and TELEGRAM_API_HASH at https://my.telegram.org
# ==============================================================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_SERVER=http://telegram-bot-api:8081

# ==============================================================================
# Media Limits & Auto-Compression
# ==============================================================================
# Maximum video duration in seconds (Default: 900 = 15 minutes)
MAX_VIDEO_DURATION_SECONDS=900

# Maximum video file size for direct upload in megabytes (Default: 400 MB)
MAX_FILE_SIZE_MB=400

# Maximum video file size threshold for auto-compression in megabytes (Default: 650 MB)
# Videos between MAX_FILE_SIZE_MB (400 MB) and MAX_COMPRESS_SIZE_MB (650 MB) are automatically
# re-encoded via single-pass ffmpeg down to ~380 MB before transmission.
MAX_COMPRESS_SIZE_MB=650
