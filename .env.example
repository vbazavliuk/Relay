# ==============================================================================
# Relay Telegram Bot Configuration
# ==============================================================================

# Required: Telegram Bot Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Optional: Concurrency limit for simultaneous media downloads (Default: 3)
# Keeps CPU and RAM under control on small VPS servers
MAX_CONCURRENT_DOWNLOADS=3

# Optional: Path to cookies file for bypassing Instagram / X restrictions (Default: cookies.txt)
COOKIES_FILE=cookies.txt
